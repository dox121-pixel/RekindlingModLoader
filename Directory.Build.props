<Project>

  <!--
    Path to a Rekindling install. Override on the command line if yours differs:
        dotnet build -p:RekindlingDir="D:\Games\Rekindling"
  -->
  <PropertyGroup>
    <RekindlingDir Condition="'$(RekindlingDir)' == ''">C:\SteamLibrary\steamapps\common\Rekindling</RekindlingDir>
    <HasGameInstall Condition="Exists('$(RekindlingDir)\MonoGame.Framework.dll')">true</HasGameInstall>
    <HasGameInstall Condition="'$(HasGameInstall)' == ''">false</HasGameInstall>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>Rekindling Mod Loader</Company>
    <Version>0.2.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    MonoGame is needed to compile against, but never shipped: at runtime the loader always
    binds to the copy the game already has. When a game install is present its own assembly is
    referenced, which guarantees an exact identity match. Otherwise the equivalent NuGet package
    stands in, so the loader can be built and tested on a machine without the game - which is
    what makes CI and outside contributions possible.

    3.8.0.1641 is the assembly version Rekindling ships. Keep these in step.
  -->
  <ItemGroup Condition="'$(HasGameInstall)' == 'true'">
    <Reference Include="MonoGame.Framework">
      <HintPath>$(RekindlingDir)\MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(HasGameInstall)' != 'true'">
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.0.1641" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="ReportGameInstall" BeforeTargets="Build" Condition="'$(HasGameInstall)' != 'true'">
    <Message Importance="high"
             Text="No Rekindling install found at '$(RekindlingDir)'; building against the MonoGame NuGet package instead. The output still runs against the game's own copy." />
  </Target>

</Project>
